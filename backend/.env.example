# Plantilla de variables para ejecutar Spring desde el proceso o el IDE.
# Spring Boot no carga este archivo automáticamente.
SERVER_PORT=8080
FRONTEND_URL=http://localhost:5173
RECOVERY_URL=http://localhost:5173/recuperar-acceso
DB_URL=jdbc:mysql://localhost:3306/gtel_talento?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=
JPA_DDL_AUTO=validate

# Genera secretos privados y distintos de al menos 32 bytes.
JWT_SECRET=
OTP_HASH_SECRET=
JWT_EXPIRATION_MS=3600000

MAIL_USERNAME=
MAIL_PASSWORD=

# Solo desarrollo local. Nunca habilitar en entornos compartidos o producción.
TEST_ACCESS_ENABLED=false

# Límites HTTP opcionales.
MULTIPART_MAX_FILE_SIZE=10MB
MULTIPART_MAX_REQUEST_SIZE=12MB

# Retención de Mesa de Ayuda.
SUPPORT_CLEANUP_ENABLED=true
SUPPORT_CLEANUP_RETENTION_DAYS=7
SUPPORT_CLEANUP_CRON=0 0 2 * * MON
SUPPORT_CLEANUP_ZONE=America/Lima
