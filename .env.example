# Copia este archivo como .env y reemplaza todos los valores CHANGE_ME.
# Docker Compose carga .env automáticamente y Git no lo versiona.

# MySQL
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD
MYSQL_DATABASE=gtel_talento
MYSQL_USER=gtel_user
MYSQL_PASSWORD=CHANGE_ME_APP_PASSWORD
MYSQL_HOST_PORT=3307

# Backend
BACKEND_HOST_PORT=8080
JWT_SECRET=CHANGE_ME_WITH_AT_LEAST_64_RANDOM_BYTES
OTP_HASH_SECRET=CHANGE_ME_WITH_A_DIFFERENT_64_BYTE_SECRET
MAIL_USERNAME=CHANGE_ME_EMAIL
MAIL_PASSWORD=CHANGE_ME_APP_PASSWORD
FRONTEND_URL=http://localhost:3000
RECOVERY_URL=http://localhost:3000/recuperar-acceso
# Solo desarrollo local. Debe permanecer false en entornos compartidos y producción.
TEST_ACCESS_ENABLED=false

# Frontend
FRONTEND_HOST_PORT=3000
VITE_API_URL=http://localhost:8080
VITE_DATA_MODE=api
VITE_RECRUITER_EMAIL=talento@gtel.com.pe
